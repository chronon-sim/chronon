# SPDX-License-Identifier: MPL-2.0
@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(stdexec CONFIG)
find_dependency(yaml-cpp CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/ChrononFindFmt.cmake")
if(NOT ChrononFmt_FOUND)
    set(chronon_FOUND FALSE)
    set(chronon_NOT_FOUND_MESSAGE "${ChrononFmt_NOT_FOUND_MESSAGE}")
    return()
endif()
find_dependency(ZLIB)
if(NOT TARGET yaml-cpp::yaml-cpp)
    add_library(yaml-cpp::yaml-cpp INTERFACE IMPORTED)
    set_property(TARGET yaml-cpp::yaml-cpp PROPERTY INTERFACE_LINK_LIBRARIES yaml-cpp)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ChrononTargets.cmake")
if(NOT TARGET chronon::core)
    add_library(chronon::core ALIAS chronon::chronon)
endif()
if(NOT TARGET chronon::observe)
    add_library(chronon::observe ALIAS chronon::chronon_observe)
endif()
check_required_components(chronon)
